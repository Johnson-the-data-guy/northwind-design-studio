<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script>
    (function () {
      if (sessionStorage.getItem('theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Checkout canceled — Northwind</title>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,450;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <button type="button" id="themeToggle" class="theme-toggle theme-toggle--fixed" aria-label="Switch to dark mode">🌙</button>
  <main style="max-width: 640px; margin: 0 auto; padding: 6rem 1.5rem; text-align: center;">
    <h1 style="font-size: 2rem; margin-bottom: 1rem;">Checkout canceled.</h1>
    <p style="color: var(--ink-soft); margin-bottom: 2rem;">No charge was made. You can pick a plan again whenever you&rsquo;re ready.</p>
    <a href="/#pricing" class="btn btn--primary">Back to pricing</a>
  </main>
  <script src="/js/theme.js"></script>
</body>
</html>
