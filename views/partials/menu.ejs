<nav class="site-menu" id="siteMenu" aria-hidden="true">
  <h2 class="site-menu__title">Menu</h2>

  <ul class="site-menu__links">
    <% navLinks.forEach(function(link) { %>
      <li><a href="<%= link.href %>"><%= link.text %></a></li>
    <% }); %>
  </ul>

  <ul class="site-menu__tags">
    <% categoryTags.forEach(function(tag) { %>
      <li><button type="button" class="site-menu__tag"><%= tag %></button></li>
    <% }); %>
  </ul>

  <p class="site-menu__copyright">&copy; Northwind Design Studio. All rights reserved. <%= year %>.</p>
</nav>
